                <story-points>
                  <story-point caption='1.Shows the total number of houses in the dataset.                                                                                     2.Shows the average sale price of houses.          3.Shows the basement area of houses in square feet.' captured-sheet='Sheet 7' id='1' />
                  <story-point caption='This chart shows the relationship between total house sales and the years since renovation. It highlights how recent renovations can improve property sales.' captured-sheet='Sheet 4' id='2' />
                  <story-point caption='This chart shows the age of renovated and non-renovated houses, helping compare their age distribution.' captured-sheet='Sheet 5' id='3' />
                  <story-point caption='This chart shows that house age is more closely related to the number of bedrooms than bathrooms and floors.' captured-sheet='Sheet 6' id='4' />
                  <story-point captured-sheet='Dashboard 1' id='5' />
                </story-points>
              </flipboard>
